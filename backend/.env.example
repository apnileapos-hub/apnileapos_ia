# APNILEAP Backend Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL connection string (Render Postgres)
DATABASE_URL=

# JWT signing secret (set a strong random value)
JWT_SECRET=

# Jira Cloud credentials (live Jira integration)
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_API_TOKEN=

# SMTP (required for OTP login emails to reach real users)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Public URL of the deployed backend (used for uploaded file URLs)
BACKEND_PUBLIC_URL=

# Comma-separated allowed CORS origins (e.g. https://frontend.onrender.com)
CORS_ORIGINS=

# Email branding / redirect
SMTP_FROM_NAME=
SMTP_REDIRECT_TO=

# Twilio WhatsApp/SMS fan-out (optional; skipped if unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEMO_PHONE_1=
DEMO_PHONE_2=